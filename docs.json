{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AgentMuxer",
  "colors": {
    "primary": "#087C56",
    "light": "#6FD4AD",
    "dark": "#087C56"
  },
  "favicon": "/favicon.ico",
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Marketplace",
          "icon": "store",
          "href": "https://agentmuxer.com"
        },
        {
          "anchor": "TypeScript SDK",
          "icon": "code",
          "href": "https://www.npmjs.com/package/@agentmuxer/sdk"
        }
      ]
    },
    "tabs": [
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "sdk/openai",
              "sdk/claude-agent",
              "sdk/ai-sdk",
              "sdk/native-mcp"
            ]
          },
          {
            "group": "Your application",
            "pages": [
              "sdk/applications",
              "sdk/production"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Use AgentMuxer",
            "pages": [
              "guides/how-it-works",
              "guides/connect",
              "guides/use-tools"
            ]
          },
          {
            "group": "Account and trust",
            "pages": [
              "guides/billing",
              "guides/security"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Reference",
            "pages": [
              "reference/sdk",
              "reference/mcp",
              "reference/compatibility",
              "reference/troubleshooting",
              "changelog"
            ]
          }
        ]
      }
    ]
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://agentmuxer.com"
  },
  "navbar": {
    "links": [
      {
        "href": "/changelog",
        "label": "Changelog"
      },
      {
        "label": "Support",
        "href": "mailto:founders@amorphiclabs.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.agentmuxer.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/amorphiclabs",
      "github": "https://github.com/amorphic-labs",
      "linkedin": "https://linkedin.com/company/amorphic-labs"
    }
  },
  "description": "Give your agents one connection to discover and use tools. Build with the AgentMuxer SDK or connect your existing agent.",
  "appearance": {
    "default": "system"
  },
  "background": {
    "color": {
      "light": "#F2F3F0",
      "dark": "#0A0B0C"
    }
  },
  "fonts": {
    "heading": {
      "family": "Spectral",
      "weight": 300
    },
    "body": {
      "family": "Space Grotesk"
    }
  },
  "styling": {}
}
